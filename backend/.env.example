PORT=3000
DB_PATH=./data/app.db
TOKEN_PEPPER=change-me-to-a-long-random-string-min-32-chars
ADMIN_KEY=admin-dev-key
CORS_ORIGIN=*
NODE_ENV=development
# Optional: absolute path to dashboard dir for same-origin serving.
# Defaults to ../dashboard when it exists, else API-only mode.
# DASHBOARD_DIR=/app/dashboard

# ---- Supabase (Postgres) — optional, production ----
# Leave unset (or empty) to keep the zero-config local SQLite file.
# Set it to store everything in Supabase instead (same API, same behavior).
# Use the Transaction Pooler URL (Supabase dashboard → Connect → Transaction pooling):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# First-time setup: paste src/db/schema.pg.sql into the Supabase SQL editor,
# run it once, then: npm run seed
# Health check reports which store is live: /health → {"db":"supabase/postgres"|"sqlite"}
