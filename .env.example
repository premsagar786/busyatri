# Copy the values you need into real env files (never commit those).
# API server and database tooling read DATABASE_URL + CLERK_* from the environment.

# Postgres connection string (Supabase / Neon / local Postgres all work)
DATABASE_URL="postgresql://user:password@localhost:5432/bus_tracker"

# Clerk (https://dashboard.clerk.com → API Keys)
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# API server port (local)
PORT="5000"

# Expo web client (public key only — safe to expose, must match Clerk app)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
