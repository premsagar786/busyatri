{
  "expo": {
    "name": "Campus Bus Tracker",
    "slug": "campus-bus-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campus-bus-tracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f4f6f0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.busyatri.tracker",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Campus Bus Tracker to share the bus location in the background while the driver is on duty."
      }
    },
    "android": {
      "package": "com.busyatri.tracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#f4f6f0"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Campus Bus Tracker to share the bus location while the driver is on duty.",
          "locationAlwaysAndWhenInUsePermission": "Allow Campus Bus Tracker to keep sharing the bus location in the background while the driver is on duty.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#176d5d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "bee4ef97-ae49-4f45-a942-d54a3fcd56a8"
      }
    },
    "owner": "premsagar465s-team"
  }
}
